# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis no
# painel da hospedagem (produção). Nunca faça commit do .env.local.
# Sem estas variáveis o site funciona normalmente, com o conteúdo estático
# de src/data/site.ts.

# --- Instagram: use UMA das duas opções ---
# Opção sem acesso à conta da loja (Business Discovery): token e ID da SUA
# conta profissional do Instagram, ligada a uma Página do Facebook sua.
# Use um token de Página, que não expira.
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Opção para depois da entrega: URL do feed JSON do https://behold.so
# (exige login da dona). Se preenchida, tem prioridade sobre a de cima.
BEHOLD_FEED_URL=

# --- Google Avaliações (Places API New) ---
# Chave do Google Cloud, restrita à "Places API (New)".
GOOGLE_PLACES_API_KEY=
# Place ID da Guardiã Plantas (começa com "ChIJ...").
GOOGLE_PLACE_ID=
